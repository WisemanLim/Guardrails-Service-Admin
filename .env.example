PORT=8084
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10
TOTP_ISSUER=Guardrails-Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# DB backend (postgres | sqlite)
DB_DRIVER=postgres
SQLITE_PATH=./var/admin.db

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=guardrails
POSTGRES_USER=guardrails
POSTGRES_PASSWORD=guardrails

# Downstream
POLICY_ENGINE_URL=http://127.0.0.1:8082
